{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FormulaSnap",
  "version": "0.1.8",
  "identifier": "com.formulasnap.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "FormulaSnap",
        "width": 1440,
        "height": 940,
        "minWidth": 1050,
        "minHeight": 740,
        "center": true,
        "decorations": false,
        "resizable": true,
        "backgroundColor": "#eaf2ff",
        "create": false
      }
    ],
    "security": {
      "capabilities": [
        "main-capability"
      ],
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost 'self' asset: http://asset.localhost http://127.0.0.1:5173"
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "将公式图片转换为 LaTeX",
    "longDescription": "从截图或公式图片识别 LaTeX，支持编辑、预览与 Word 公式导出。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/ocr-model/"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}

